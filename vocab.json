python -c "
import json
import numpy as np
from pathlib import Path

# Load a labels CSV to build vocab
import pandas as pd
df = pd.read_csv('data/processed/kaggle/train/labels.csv')
words = df['word'].tolist()

# Build vocabulary
chars = sorted(set(''.join(words)))
vocab = {'<BLANK>': 0, '<UNK>': 1}
for i, c in enumerate(chars, start=2):
    vocab[c] = i

# Save
with open('data/processed/kaggle/vocab.json', 'w') as f:
    json.dump(vocab, f, indent=2)

print(f'✅ Created vocab.json with {len(vocab)} characters')
"